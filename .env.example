# Copy to .env for local use; keep .env private.
GONGWEN_ENV=development
GONGWEN_HOST=127.0.0.1
GONGWEN_PORT=8787
GONGWEN_ACCESS_LOG=false
# Leave unset to use the OS per-user application-data directory. Set an
# absolute private path only when an explicit location is needed.
# GONGWEN_DATA_DIR=/ABSOLUTE/PRIVATE/PATH/yanzhang-gongwen

# Production requires two different random values, each at least 32 bytes.
GONGWEN_ACCESS_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GONGWEN_MCP_ACCESS_TOKEN=CHANGE_ME_WITH_AN_INDEPENDENT_32_BYTE_RANDOM_TOKEN
GONGWEN_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
GONGWEN_CORS_ORIGINS=
GONGWEN_ENABLE_INSECURE_PEOPLE_SEARCH=false

# Optional server-owned model connection. Blank means deterministic demo mode.
GONGWEN_LLM_PROVIDER=
GONGWEN_LLM_MODEL=
GONGWEN_LLM_API_KEY=
GONGWEN_LLM_BASE_URL=
GONGWEN_LLM_TIMEOUT_SECONDS=
GONGWEN_CLIENT_LLM_BASE_URL_ALLOWLIST=
