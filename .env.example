# Copy to .env for local use, or let deploy/gongwen/scripts/start.sh create
# deploy/gongwen/.env. Keep every real .env file private and mode 0600.
#
# YANZHANG_* is the primary v0.2 spelling. Existing GONGWEN_* names remain
# compatible; when both spellings are present, the YANZHANG_* value wins.

# Direct local application defaults.
YANZHANG_ENV=development
YANZHANG_HOST=127.0.0.1
YANZHANG_PORT=8787
YANZHANG_WORKERS=1
YANZHANG_ACCESS_LOG=false
# Keep API and MCP authentication enabled unless this is an isolated local-only
# instance. Production validation requires explicit credentials.
YANZHANG_ALLOW_UNAUTHENTICATED=false
# Leave unset to use the OS per-user application-data directory. For an
# explicit location, use an absolute private directory.
# YANZHANG_DATA_DIR=/ABSOLUTE/PRIVATE/PATH/yanzhang

# Production authentication. The deployment start script replaces these
# markers with two independent random values of at least 32 bytes.
YANZHANG_ACCESS_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
YANZHANG_MCP_ACCESS_TOKEN=CHANGE_ME_WITH_AN_INDEPENDENT_32_BYTE_RANDOM_TOKEN
YANZHANG_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
YANZHANG_CORS_ORIGINS=
YANZHANG_TRUSTED_PROXY_IPS=
YANZHANG_MAX_REQUEST_BYTES=2097152
YANZHANG_RATE_LIMIT_REQUESTS=120
YANZHANG_RATE_LIMIT_WINDOW_SECONDS=60
YANZHANG_HSTS_SECONDS=31536000
YANZHANG_ENABLE_INSECURE_PEOPLE_SEARCH=false

# Optional server-owned model connection. Blank values select deterministic
# local behavior. Secrets remain in the private environment file.
YANZHANG_LLM_PROVIDER=
YANZHANG_LLM_MODEL=
YANZHANG_LLM_API_KEY=
YANZHANG_LLM_BASE_URL=
YANZHANG_LLM_TIMEOUT_SECONDS=
# Production permits HTTP here only for an explicitly enabled loopback model.
YANZHANG_ALLOW_INSECURE_LOCAL_MODEL=false
YANZHANG_CLIENT_LLM_BASE_URL_ALLOWLIST=

# Local-first Compose publishing defaults. A public deployment sets one bare
# hostname as YANZHANG_SITE_ADDRESS, uses 0.0.0.0 as the bind address and adds
# that hostname to YANZHANG_ALLOWED_HOSTS.
YANZHANG_SITE_ADDRESS=:80
YANZHANG_BIND_ADDRESS=127.0.0.1
YANZHANG_HTTP_PORT=8080
YANZHANG_HTTPS_PORT=8443
YANZHANG_PROXY_MAX_REQUEST_SIZE=2MB

# Stable object names preserve the existing v0.1 data volume during upgrades.
YANZHANG_IMAGE=gongwen-web:local
YANZHANG_CADDY_IMAGE=caddy:2.10-alpine
YANZHANG_DATA_VOLUME=gongwen-web-data
YANZHANG_CADDY_DATA_VOLUME=gongwen-web-caddy-data
YANZHANG_CADDY_CONFIG_VOLUME=gongwen-web-caddy-config
YANZHANG_NETWORK=gongwen-web-network
YANZHANG_NETWORK_SUBNET=172.30.88.0/24
YANZHANG_COMPOSE_PROJECT=gongwen-web

TZ=Asia/Shanghai
YANZHANG_LOG_MAX_SIZE=10m
YANZHANG_LOG_MAX_FILES=3
