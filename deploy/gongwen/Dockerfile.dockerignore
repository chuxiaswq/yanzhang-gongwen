# Dockerfile-specific ignore rules for the standalone Yanzhang build context.
.git
.github
.DS_Store
.env
.env.*
config.yaml

.gongwen-data/
.yanzhang-data/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.venv-*/
**/__pycache__/
**/*.py[cod]
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.bak
*.backup
*.csv
*.doc
*.docx
*.pdf
*.zip
*.tar.gz
*.tgz
*.gz
*.7z
*.rar
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
.netrc
.npmrc
.pypirc
auth.json
credentials.json
secrets.json
*.aac
*.avi
*.flac
*.gif
*.jpeg
*.jpg
*.m4a
*.mkv
*.mov
*.mp3
*.mp4
*.png
*.webp
*.wav
build/
dist/
*.egg-info/

# Development/test inputs are not needed by the application image.
tests/
scripts/
samples/
assets/

# Local deployment state. Keep the checked-in examples and proxy config.
deploy/gongwen/.env
deploy/gongwen/backups/
deploy/gongwen/.operation.lock/

# Logs and command output
*.log
*.out
