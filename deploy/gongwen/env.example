# Copy to deploy/gongwen/.env. start.sh does this automatically on first run.

# Local-only default: accept local hostnames on http://127.0.0.1:8080.
GONGWEN_SITE_ADDRESS=:80
GONGWEN_BIND_ADDRESS=127.0.0.1
GONGWEN_HTTP_PORT=8080
GONGWEN_HTTPS_PORT=8443
GONGWEN_ACCESS_LOG=false

# For a public domain, use one bare hostname (without scheme or port), set the
# four values below and point DNS to the server:
# GONGWEN_SITE_ADDRESS=gongwen.example.com
# GONGWEN_BIND_ADDRESS=0.0.0.0
# GONGWEN_HTTP_PORT=80
# GONGWEN_HTTPS_PORT=443

# Personal access token used by the application login screen and API Bearer
# authentication. start.sh replaces this marker with a strong random token.
GONGWEN_ACCESS_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Independent Bearer token for the Streamable HTTP MCP endpoint at /mcp.
# start.sh generates and atomically saves it without printing the full value.
GONGWEN_MCP_ACCESS_TOKEN=CHANGE_ME_WITH_AN_INDEPENDENT_32_BYTE_RANDOM_TOKEN

# Production request boundary. Add the public domain when one is used, for
# example: 127.0.0.1,localhost,[::1],gongwen.example.com
# SQLite is kept on a single application worker; Caddy handles concurrent
# connections and the app performs bounded async model/source requests.
GONGWEN_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
GONGWEN_CORS_ORIGINS=
GONGWEN_MAX_REQUEST_BYTES=2097152
# Keep this proxy limit aligned with the application limit above.
GONGWEN_PROXY_MAX_REQUEST_SIZE=2MB
GONGWEN_RATE_LIMIT_REQUESTS=120
GONGWEN_RATE_LIMIT_WINDOW_SECONDS=60
GONGWEN_HSTS_SECONDS=31536000

# Privacy default: the current People search endpoint is HTTP, so automatic
# People discovery stays off. Manual HTTPS article import remains available.
# Setting this to true sends search keywords and date ranges in plaintext.
GONGWEN_ENABLE_INSECURE_PEOPLE_SEARCH=false

# Optional server-owned model connection. Secrets stay in the local .env and
# are not included in the image. Leave all fields blank for deterministic mode.
# deepseek/qwen/custom select the OpenAI-compatible adapter and require the
# matching explicit base URL.
GONGWEN_LLM_PROVIDER=
GONGWEN_LLM_MODEL=
GONGWEN_LLM_API_KEY=
GONGWEN_LLM_BASE_URL=
GONGWEN_LLM_TIMEOUT_SECONDS=

# Production browser-owned model connections may leave base_url blank to use a
# built-in provider endpoint. Any custom base_url entered in the page must match
# one exact HTTPS value from this comma-separated list (a trailing slash is
# treated equivalently). This does not restrict GONGWEN_LLM_BASE_URL above.
# GONGWEN_CLIENT_LLM_BASE_URL_ALLOWLIST=https://api.deepseek.com/v1,https://dashscope.aliyuncs.com/compatible-mode/v1
GONGWEN_CLIENT_LLM_BASE_URL_ALLOWLIST=

# Images and stable Docker object names. The application identity is fixed at
# UID/GID 10001 so an existing data volume keeps the same ownership on updates.
GONGWEN_IMAGE=gongwen-web:local
GONGWEN_CADDY_IMAGE=caddy:2.10-alpine
GONGWEN_DATA_VOLUME=gongwen-web-data
GONGWEN_CADDY_DATA_VOLUME=gongwen-web-caddy-data
GONGWEN_CADDY_CONFIG_VOLUME=gongwen-web-caddy-config
GONGWEN_NETWORK=gongwen-web-network
GONGWEN_NETWORK_SUBNET=172.30.88.0/24
GONGWEN_COMPOSE_PROJECT=gongwen-web

TZ=Asia/Shanghai
GONGWEN_LOG_MAX_SIZE=10m
GONGWEN_LOG_MAX_FILES=3
